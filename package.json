{
  "name": "farm-script",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build && npm run build:server",
    "test": "tsx --test src/*.test.ts",
    "test:e2e": "node tests/smoke.cjs && node tests/board-and-trees.cjs && node tests/shop.cjs && node tests/fleet.cjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "node dist-server/index.js",
    "test:server": "tsx --test server/*.test.ts",
    "test:session": "node tests/session.cjs",
    "test:fleet": "node tests/fleet.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "monaco-editor": "^0.52.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "typescript": "~5.7.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "vite": "^6.1.0"
  }
}
