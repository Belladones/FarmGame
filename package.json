{
  "name": "farm-script",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build && npm run build:server",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/smoke.cjs && node tests/board-and-trees.cjs && node tests/shop.cjs && node tests/fleet.cjs && node tests/missions.cjs && node tests/ux.cjs && node tests/sidebar.cjs && node tests/progression.cjs && node tests/inventory.cjs && npm run test:programs && npm run test:companion && npm run test:onboarding && npm run test:saves && npm run test:research-groups && npm run test:equipment && npm run test:imports && npm run test:sticker-pack && npm run test:legendary && npm run test:workshop",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "node dist-server/server/index.js",
    "test:server": "tsx --test server/*.test.ts",
    "test:session": "node tests/session.cjs",
    "test:fleet": "node tests/fleet.cjs",
    "test:missions": "node tests/missions.cjs",
    "test:ux": "node tests/ux.cjs",
    "test:sidebar": "node tests/sidebar.cjs",
    "test:progression": "node tests/progression.cjs",
    "test:inventory": "node tests/inventory.cjs",
    "test:programs": "node tests/programs.cjs",
    "test:companion": "node tests/companion.cjs",
    "assets:luma": "node scripts/prepare-luma.mjs",
    "assets:luma:previews": "node scripts/render-luma-previews.mjs",
    "test:onboarding": "node tests/onboarding.cjs",
    "test:saves": "node tests/save-slots.cjs",
    "test:research-groups": "node tests/research-groups.cjs",
    "test:equipment": "node tests/asset-upgrades.cjs",
    "test:imports": "node tests/program-imports.cjs",
    "test:sticker-pack": "node tests/sticker-pack.cjs",
    "test:legendary": "node tests/legendary-skins.cjs",
    "test:workshop": "node tests/workshop.cjs",
    "test:catalog": "node tests/catalog.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "monaco-editor": "^0.52.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "typescript": "~5.7.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "vite": "^6.1.0"
  }
}
